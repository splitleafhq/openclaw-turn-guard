{
  "name": "@splitleafhq/openclaw-turn-guard",
  "version": "0.1.1",
  "private": true,
  "description": "OpenClaw plugin that publishes a research agent's briefs to a host folder.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "agents",
    "research"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 'test/*.test.ts'"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "openclaw": "2026.10.5",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.5",
      "minGatewayVersion": "2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5",
      "pluginSdkVersion": "2026.10.5"
    }
  },
  "dependencies": {
    "typebox": "1.3.34"
  },
  "files": [
    "dist/",
    "src/",
    "openclaw.plugin.json"
  ]
}
